<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.companyname.FigureDrawing</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <!--
    This app project lives at the repo root, so its default **/*.cs glob would otherwise pull in
    the sibling FigureDrawing.Core / FigureDrawing.Tests sources. They are referenced as projects
    instead; exclude their folders from this project's compilation.
  -->
  <ItemGroup>
    <Compile Remove="FigureDrawing.Core\**\*.cs" />
    <Compile Remove="FigureDrawing.Tests\**\*.cs" />
    <Compile Remove="FigureDrawing.UITests\**\*.cs" />
  </ItemGroup>

  <!-- LiteDB comes transitively via FigureDrawing.Core (which owns Data/SettingsStore). -->
  <ItemGroup>
    <ProjectReference Include="FigureDrawing.Core\FigureDrawing.Core.csproj" />
  </ItemGroup>

  <!--
    One-command run: `dotnet build FigureDrawing.csproj -t:RunEmulator` boots the
    FigureDrawing_Pixel emulator (if none is attached) and deploys + launches the app via the
    run-app script. Force a device when several are attached with -p:RunTarget=emulator-5554.
    Delegates to the same scripts/run-app.* used for a manual run so the flow stays in one place.
  -->
  <Target Name="RunEmulator">
    <PropertyGroup>
      <_RunTargetArg Condition="'$(RunTarget)' != ''">-Target $(RunTarget)</_RunTargetArg>
    </PropertyGroup>
    <Exec Condition="'$(OS)' == 'Windows_NT'"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;scripts\run-app.ps1&quot; $(_RunTargetArg)" />
    <Exec Condition="'$(OS)' != 'Windows_NT'"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="bash scripts/run-app.sh $(RunTarget)" />
  </Target>
</Project>