<Project>

  <Import Project="$(MSBuildThisFileDirectory)version.props" />

  <!--
    Version derivation. version.props holds the four numbers; everything a build or a device sees is
    computed here so no second copy can drift:

      ApplicationDisplayVersion -> android:versionName, the string a human reads ("1.2.3", or
                                   "1.2.3.4" when a build number is in play).
      ApplicationVersion        -> android:versionCode, the packed integer Android compares when
                                   deciding whether an APK is an upgrade. See version.props.

    -p:FdBuildNumber=7 on the command line overrides the file (global properties win), which is how
    a CI job stamps a build without committing.

    These are set for every project in the repo. Only the app project consumes the Application*
    pair; Core/Tests take Version and InformationalVersion, so an assembly pulled out of a build
    output can still be identified.
  -->
  <PropertyGroup>
    <_FdCodeMajor>$([MSBuild]::Multiply($(FdVersionMajor), 1000000))</_FdCodeMajor>
    <_FdCodeMinor>$([MSBuild]::Multiply($(FdVersionMinor), 10000))</_FdCodeMinor>
    <_FdCodePatch>$([MSBuild]::Multiply($(FdVersionPatch), 100))</_FdCodePatch>
    <_FdCode>$([MSBuild]::Add($(_FdCodeMajor), $(_FdCodeMinor)))</_FdCode>
    <_FdCode>$([MSBuild]::Add($(_FdCode), $(_FdCodePatch)))</_FdCode>
    <_FdCode>$([MSBuild]::Add($(_FdCode), $(FdBuildNumber)))</_FdCode>

    <FdSemanticVersion>$(FdVersionMajor).$(FdVersionMinor).$(FdVersionPatch)</FdSemanticVersion>
    <FdFullVersion>$(FdSemanticVersion)</FdFullVersion>
    <FdFullVersion Condition="'$(FdBuildNumber)' != '0'">$(FdSemanticVersion).$(FdBuildNumber)</FdFullVersion>

    <ApplicationVersion>$(_FdCode)</ApplicationVersion>
    <ApplicationDisplayVersion>$(FdFullVersion)</ApplicationDisplayVersion>

    <Version>$(FdSemanticVersion)</Version>
    <AssemblyVersion>$(FdSemanticVersion).0</AssemblyVersion>
    <FileVersion>$(FdVersionMajor).$(FdVersionMinor).$(FdVersionPatch).$(FdBuildNumber)</FileVersion>
    <InformationalVersion>$(FdFullVersion)</InformationalVersion>
  </PropertyGroup>

  <!--
    Supplies the Android SDK and JDK locations to every build in this repo, so an IDE build
    (Ctrl+B in Visual Studio / Rider) succeeds without hand-passing
    -p:AndroidSdkDirectory / -p:JavaSdkDirectory on the command line.

    Every rule is guarded so it never overrides an explicit choice or breaks another machine:
      - an already-set property (env var or an explicit -p: on the CLI) always wins, and
      - each fallback path is applied only when it Exists().
    On a machine without these exact paths the properties simply stay empty, leaving the CLI
    -p: workflow (see memory: android-build-env) unchanged.
  -->

  <!-- Android SDK: prefer ANDROID_HOME, else the default per-user install location. -->
  <PropertyGroup Condition="'$(AndroidSdkDirectory)' == ''">
    <AndroidSdkDirectory Condition="'$(ANDROID_HOME)' != '' and Exists('$(ANDROID_HOME)')">$(ANDROID_HOME)</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>

  <!--
    Java SDK: Microsoft.Android 35 rejects the machine-default JDK 25 (JAVA_HOME) with
    "XA0034: Failed to get the Java SDK version", so point the build at JDK 17.
  -->
  <PropertyGroup Condition="'$(JavaSdkDirectory)' == ''">
    <JavaSdkDirectory Condition="Exists('$(ProgramFiles)\Microsoft\jdk-17.0.19.10-hotspot')">$(ProgramFiles)\Microsoft\jdk-17.0.19.10-hotspot</JavaSdkDirectory>
  </PropertyGroup>

</Project>
