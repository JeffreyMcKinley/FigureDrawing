<?xml version="1.0" encoding="utf-8"?>
<!--
  .btn.btn-primary. Nocturne's primary button is an accent outline, not a filled slab; the press
  state fills it with the same 16% accent wash the selected chips use. The disabled face drops to a
  neutral edge, which is the Start button's resting state until a folder is picked.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/neutral_800" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/accent_wash" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
</selector>
