<?xml version="1.0" encoding="utf-8"?>
<!--
  The design system's .card at elevation "sm". Nocturne's small elevation is a hairline edge rather
  than a drop shadow (0 0 0 1px #3f424d), which is what a stroke gives here.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/radius_md" />
    <solid android:color="@color/surface" />
    <stroke android:width="1dp" android:color="@color/neutral_800" />
</shape>
