<?xml version="1.0" encoding="utf-8"?>
<!--
  The design system's .tool-chip. A chip is a toggle: the screen sets View.Selected from the Core
  state it reflects (the chosen preset, or a ViewerTools flag), and the selected face is the
  accent-washed one.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/accent_wash" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/neutral_800" />
        </shape>
    </item>
</selector>
