<?xml version="1.0" encoding="utf-8"?>
<!-- Ground behind a reference thumbnail, so a portrait image in a 3:4 cell still reads as a tile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/radius_md" />
    <solid android:color="@color/neutral_900" />
    <stroke android:width="1dp" android:color="@color/neutral_800" />
</shape>
