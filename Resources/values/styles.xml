<?xml version="1.0" encoding="utf-8"?>
<!--
  The app theme. Nocturne is a dark system, so the whole app runs on one dark theme rather than
  following the device's day/night setting - a reference image is judged against its surround, and
  a light chrome would change how the drawer reads the values in it.

  Inter is the design system's typeface and is bundled (Resources/font/). It reaches every view
  through the theme's text appearances, NOT through a bare android:fontFamily item on the theme -
  TextView never reads that attribute off the theme, so a theme-level fontFamily silently does
  nothing. TextView and EditText resolve ?android:attr/textAppearance, Button resolves
  ?android:attr/textAppearanceButton; overriding those two is what carries the typeface everywhere.
  Styles below only name a font when the design asks for a specific weight.
-->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:textAppearance">@style/TextAppearance.Inter</item>
        <item name="android:textAppearanceInverse">@style/TextAppearance.Inter</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Inter</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Inter</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Inter</item>
        <item name="android:textAppearanceButton">@style/TextAppearance.Inter</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/neutral_400</item>
        <item name="android:textColorHint">@color/neutral_600</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/neutral_500</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!--
      The player screen. Same theme, named so the intent stays visible at the [Activity] attribute:
      the pose is full-bleed and an opaque title bar would eat the top of the stage.
    -->
    <style name="AppTheme.NoActionBar" parent="AppTheme" />

    <!--
      The default text appearance for the whole app: Inter at the body weight. Colour is left to the
      theme and to the individual styles, so this carries the typeface and nothing else.
    -->
    <style name="TextAppearance.Inter" parent="@android:style/TextAppearance.Material">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
      Widget styles = the design system's component classes. Every repeated control in the two
      layouts is one of these, so a retune happens here rather than in a dozen places.
    -->

    <!-- .tool-chip - a toggle whose selected face is accent-washed. -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/chip_min_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">@dimen/space_4</item>
        <item name="android:paddingRight">@dimen/space_4</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- .btn.btn-primary -->
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- .btn.btn-secondary -->
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- .btn.btn-ghost -->
    <style name="GhostButton" parent="PrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:paddingLeft">@dimen/space_3</item>
        <item name="android:paddingRight">@dimen/space_3</item>
    </style>

    <!--
      .input. EditText is the one control the theme's text appearances do not reach - the platform's
      Widget.Material.EditText pins its own inverse appearance - so the family is named here.
    -->
    <style name="Input">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/neutral_600</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">@dimen/space_4</item>
        <item name="android:paddingRight">@dimen/space_4</item>
    </style>

    <!-- One row of the Settings screen: label + help on the left, an On/Off chip on the right. -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_4</item>
    </style>

    <style name="SettingRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingRight">@dimen/space_4</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="SettingHelp">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/neutral_500</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!--
      Bottom tab: the accent bar and the label both inherit the tab's selected state
      (duplicateParentState), so selecting the tab is all the screen has to do.
    -->
    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:minHeight">@dimen/tab_min_height</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="TabIndicator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">@drawable/bg_tab_indicator</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="TabLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <!-- Kicker line above a heading: small, uppercase, wide-tracked. -->
    <style name="Kicker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/neutral_500</item>
    </style>

    <!-- The big tabular clock: pose remaining, break remaining, paused. -->
    <style name="Clock">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- .card as used by the four summary stats. -->
    <style name="StatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_4</item>
    </style>

    <style name="StatKicker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
